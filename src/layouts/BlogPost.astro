---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { CONTACT_URL } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="th">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main class="wrap">
			<article>
				<header class="post-header">
					<div class="row">
						<a href="/blog" class="pill">← บทความทั้งหมด</a>
						<span class="pill pill-yellow">
							<FormattedDate date={pubDate} />
						</span>
						{
							updatedDate && (
								<span class="pill">
									อัปเดต <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					<h1>{title}</h1>
					<p class="lead">{description}</p>
				</header>
				{
					heroImage && (
						<div class="post-hero">
							<img width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="prose">
					<slot />
				</div>
			</article>

			<section class="cta cta-compact">
				<h2>อยากให้ทีมเราช่วยดูธุรกิจของคุณ?</h2>
				<p>ปรึกษาฟรี ไม่มีข้อผูกมัด ตอบกลับภายในวันทำการ</p>
				<a href={CONTACT_URL} class="btn btn-dark">ปรึกษาฟรี →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

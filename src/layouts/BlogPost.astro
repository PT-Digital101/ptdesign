---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import Icon from '../components/Icon.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<Layout title={title} description={description} image={heroImage}>
	<article class="panel reveal">
		<div class="case-top">
			<a href="/blog" class="link-back"><Icon name="arrow-left" size={18} /> Journal</a>
			<span class="label">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<>
							· Updated <FormattedDate date={updatedDate} />
						</>
					)
				}
			</span>
		</div>
		<h1 class="display case-title">{title}</h1>
		<p class="lead">{description}</p>
		{
			heroImage && (
				<div class="case-cover">
					<img src={heroImage} alt="" width="1020" height="510" />
				</div>
			)
		}
		<div class="rich">
			<slot />
		</div>
	</article>
</Layout>

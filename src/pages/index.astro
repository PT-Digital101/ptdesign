---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHead from '../components/SectionHead.astro';
import { OWNER, SOCIALS, TECH_STACK, FAQS } from '../consts';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const recent = projects.slice(0, 4);
const industries = new Set(projects.flatMap((p) => p.data.categories)).size;
const heroSocials = SOCIALS.filter((s) => s.icon === 'line' || s.icon === 'linkedin');
---

<Layout>
	<!-- Intro -->
	<section class="panel hero reveal">
		<div class="hero-top">
			<div class="who">
				<img src={OWNER.avatar} alt={OWNER.name} width="56" height="56" class="avatar" />
				<div>
					<p class="who-name">Hello, I'm {OWNER.name} <span class="accent">({OWNER.nick})</span></p>
					<p class="label">{OWNER.role}</p>
				</div>
			</div>
			<div class="socials">
				{
					heroSocials.map((s) => (
						<a href={s.href} class="icon-btn" target="_blank" rel="noopener" aria-label={s.label}>
							<Icon name={s.icon} size={18} />
						</a>
					))
				}
			</div>
		</div>

		<h1 class="display hero-title">
			I design &amp; build websites <span class="accent">people love</span> to use.
		</h1>

		<div class="hero-bottom">
			<p class="hero-bio">
				A skilled UX/UI Designer and WordPress Web Developer with 5 years of experience in designing and
				developing user-centered websites and applications that are visually appealing and easy to use. I
				am passionate about solving complex problems through design and technology.
			</p>
			<a href="/contact" class="spin-badge" aria-label="Start a project">
				<svg viewBox="0 0 120 120" aria-hidden="true">
					<defs><path id="circle" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs>
					<text><textPath href="#circle">Available for projects · Design &amp; Dev ·</textPath></text>
				</svg>
				<span class="spin-badge-icon"><Icon name="arrow-up-right" size={26} /></span>
			</a>
		</div>

		<div class="hero-actions">
			<span class="status"><i></i> Available for new projects</span>
			<div class="row">
				<a href="/projects" class="btn">View Projects</a>
				<a href="/contact" class="btn btn-accent">Let's Connect! <Icon name="arrow-right" size={18} /></a>
			</div>
		</div>
	</section>

	<!-- Numbers -->
	<section class="stats reveal">
		<div class="stat"><b>5+</b><span>Years designing &amp; building</span></div>
		<div class="stat"><b>{projects.length}</b><span>Websites launched</span></div>
		<div class="stat"><b>{industries}</b><span>Industries served</span></div>
	</section>

	<!-- Recent works -->
	<section class="panel reveal">
		<SectionHead num="01" title="Recent Works" />
		<div class="project-grid">
			{recent.map((p) => <ProjectCard project={p} />)}
		</div>
		<a href="/projects" class="btn btn-block">View All <Icon name="arrow-right" size={18} /></a>
	</section>

	<!-- Tech stacks -->
	<section class="section reveal">
		<SectionHead num="02" title="Tech Stacks" />
		<ul class="stack">
			{
				TECH_STACK.map((t) => (
					<li class="stack-item">
						<img src={t.logo} alt="" width="56" height="56" loading="lazy" />
						<span>{t.name}</span>
					</li>
				))
			}
		</ul>
	</section>

	<!-- FAQs -->
	<section class="section reveal">
		<SectionHead num="03" title="FAQs" />
		<div class="faq">
			{
				FAQS.map((f, i) => (
					<details class="faq-item">
						<summary>
							<span>
								<span class="faq-num">{i + 1}.</span> {f.q}
							</span>
							<Icon name="plus" size={18} class="faq-icon" />
						</summary>
						<p>{f.a}</p>
					</details>
				))
			}
		</div>
	</section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import { OWNER, SKILLS } from '../consts';
---

<Layout title="About Me" description="Hi, I'm Saw Praise Taw — a UX/UI designer and WordPress developer focused on functionality, creativity, and impact.">
	<section class="panel about-intro reveal">
		<img src={OWNER.avatar} alt={OWNER.name} width="120" height="120" class="avatar avatar-lg" />
		<div>
			<SectionHead title="About Me" />
			<div class="rich">
				<p>
					Hi, I'm {OWNER.name} — a skilled <strong>UX/UI Designer and WordPress Web Developer</strong> with
					over 5 years of experience creating websites and applications that are
					<strong>user-centered, visually appealing, and easy to use</strong>.
				</p>
				<p>
					I'm passionate about solving complex problems through <strong>design and technology</strong>, always
					focusing on functionality, creativity, and impact.
				</p>
			</div>
		</div>
	</section>

	<section class="panel reveal">
		<SectionHead num="01" title="My Mission" />
		<p class="quote display">Crafting designs with <span class="accent">purpose</span> and passion.</p>
		<div class="rich">
			<p>
				I'm here to help you <strong>turn your ideas into something meaningful and impactful</strong>. I
				understand the balance between creativity and business and my goal is simple: to give you the
				<strong>tools, strategies, and designs</strong> that help you do what you love and make it thrive.
			</p>
		</div>
	</section>

	<section class="panel reveal">
		<SectionHead num="02" title="My Skills" />
		<div class="skills">
			{
				SKILLS.map((s) => (
					<article class="skill">
						<span class="skill-icon">
							<Icon name={s.icon} size={24} />
						</span>
						<div>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="panel reveal">
		<SectionHead num="03" title="Why Work With Me" />
		<p class="quote display">I'm not just here to design or build.</p>
		<div class="rich">
			<p>
				I'm here to create <strong>purposeful solutions</strong>, simplify your process, and deliver real
				value for your audience.
			</p>
		</div>
	</section>
</Layout>

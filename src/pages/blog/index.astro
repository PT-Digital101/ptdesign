---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Journal" description="Notes on UX/UI design, WordPress development and SEO from PT.">
	<section class="panel reveal">
		<SectionHead title="Journal" />
		<p class="lead">Notes on UX/UI design, WordPress development and SEO.</p>
		<div class="post-list">
			{
				posts.map((post) => (
					<a href={`/blog/${post.id}/`} class="post-row">
						{post.data.heroImage && <img src={post.data.heroImage} alt="" width="240" height="126" loading="lazy" />}
						<span class="post-row-text">
							<span class="label">
								<FormattedDate date={post.data.pubDate} />
							</span>
							<b>{post.data.title}</b>
							<span class="muted">{post.data.description}</span>
						</span>
						<Icon name="arrow-up-right" size={20} class="contact-arrow" />
					</a>
				))
			}
		</div>
	</section>
</Layout>

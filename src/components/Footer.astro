---
import Icon from './Icon.astro';
import { SOCIALS, SERVICES, SITE_TITLE } from '../consts';

const today = new Date();
// Repeat the list so the marquee loops without a gap.
const marquee = [...SERVICES, ...SERVICES, ...SERVICES, ...SERVICES];
---

<footer class="site-footer">
	<section class="wrap">
		<div class="panel cta-panel">
			<p class="eyebrow">Got something in mind?</p>
			<h2 class="display">Have a<br />project <span class="accent">idea?</span></h2>
			<a href="/contact" class="btn btn-accent">Let's Connect! <Icon name="arrow-right" size={18} /></a>
			<div class="socials">
				{
					SOCIALS.map((s) => (
						<a href={s.href} class="icon-btn" target="_blank" rel="noopener" aria-label={s.label}>
							<Icon name={s.icon} size={18} />
						</a>
					))
				}
			</div>
			<p class="muted small">Thanks for visiting, see you again soon.</p>
		</div>
	</section>

	<div class="marquee" aria-label={SERVICES.join(', ')}>
		<div class="marquee-track" aria-hidden="true">
			{marquee.map((s) => <span>{s}<i>✦</i></span>)}
		</div>
	</div>

	<div class="wrap footer-meta">
		<span>© {today.getFullYear()} {SITE_TITLE}</span>
		<a href="/blog">Journal</a>
	</div>
</footer>

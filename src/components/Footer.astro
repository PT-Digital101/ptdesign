---
import { SITE_TITLE, CONTACT_URL } from '../consts';

const today = new Date();
---

<footer class="footer">
	<div class="wrap footer-grid">
		<div>
			<a href="/" class="logo">
				<span class="logo-mark" aria-hidden="true"></span>
				{SITE_TITLE}
			</a>
			<p class="muted">ทีมเทคที่ช่วยธุรกิจไทยเติบโตบนโลกออนไลน์</p>
			<a href={CONTACT_URL} class="btn btn-orange btn-sm">ปรึกษาฟรี →</a>
		</div>
		<div>
			<h4>บริการ</h4>
			<a href="/#services">ทำเว็บไซต์</a>
			<a href="/#ai-seo">SEO และ AI SEO</a>
			<a href="/#automation">AI Automation</a>
		</div>
		<div>
			<h4>ระบบ</h4>
			<a href="/#services">ระบบจองผ่าน LINE</a>
			<a href="/#services">ระบบหลังบ้าน</a>
			<a href="/#packages">แพ็กเกจ</a>
		</div>
		<div>
			<h4>บริษัท</h4>
			<a href="/about">เกี่ยวกับเรา</a>
			<a href="/blog">บทความ</a>
			<a href="/rss.xml">RSS</a>
		</div>
	</div>
	<div class="wrap footer-bottom">
		<span>© {today.getFullYear()} {SITE_TITLE}</span>
		<span>นโยบายความเป็นส่วนตัว · ข้อกำหนดการใช้งาน</span>
	</div>
</footer>
